# TRUSTVEX environment configuration
#
# Copy this file to `.env.local` for local development:
#
#     copy .env.example .env.local
#
# `.env.local` is gitignored and must never be committed to version control.
# Next.js loads `.env.local` automatically when you run `npm run dev`.
#
# In a real deployment, set these variables through your hosting provider's
# environment config — not by copying files.

# ---------------------------------------------------------------------------
# URLhaus reputation provider (abuse.ch)
# ---------------------------------------------------------------------------
#
# URLhaus requires a free Auth-Key. Get one at:
#     https://auth.abuse.ch/
#
#   URLHAUS_ENABLED  true (or unset) -> provider is queried on every scan
#                    false           -> provider is skipped entirely
#
#   URLHAUS_API_KEY  required when URLHAUS_ENABLED is true. This is the
#                    Auth-Key from your abuse.ch account profile. It's a
#                    secret — treat it like a password.
#
# If either URLHAUS_ENABLED=false OR URLHAUS_API_KEY is missing, TRUSTVEX
# reports the provider as "not configured" and excludes it from the score.
# This is the honest behavior — the scan is not affected, and the report
# explains the omission.
URLHAUS_ENABLED=true
URLHAUS_API_KEY=38824df1906add6c75976babb8a1a3114b8af50fea65cceb



# ---------------------------------------------------------------------------
# ML service (milestone D2)
# ---------------------------------------------------------------------------
#
# TRUSTVEX sends each scan's feature vector to a Python ML microservice for
# an ML-based risk probability. This is a *best-effort* signal: if the
# service is unreachable, slow (over 5 seconds), or returns an error, the
# scan completes normally and the report says "ML: unavailable".
#
#   ML_ENABLED     true (or unset) -> attempt ML predictions on every scan
#                  false           -> skip the ML call entirely
#
#   ML_SERVICE_URL base URL of the ML service. Defaults to localhost:8000.
#
# To run the service locally:
#     cd <project root>
#     ml\.venv\Scripts\activate
#     uvicorn ml.service.main:app --reload --port 8000
ML_ENABLED=true
ML_SERVICE_URL=http://localhost:8000