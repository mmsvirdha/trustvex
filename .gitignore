# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Environment files — never commit secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env*.local

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem

# ---------------------------------------------------------------------------
# Debug logs
# ---------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
.vercel

# ---------------------------------------------------------------------------
# TRUSTVEX — local data
# ---------------------------------------------------------------------------
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# TRUSTVEX — Python virtual environment
# ---------------------------------------------------------------------------
ml/.venv/
ml/venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------------
# TRUSTVEX — ML datasets and model artifacts
# ---------------------------------------------------------------------------
# Raw downloaded data — reproducible via ml/datasets/download.py
ml/datasets/raw/

# Derived data — reproducible via ml/datasets/prepare.py
ml/datasets/derived/

# Trained model artifacts — reproducible via ml/training/train.py
# (metadata JSON is intentionally NOT ignored — it documents the model)
ml/models/*.joblib
ml/models/*.pkl
ml/models/*.pickle
ml/models/*.h5
ml/models/*.onnx

# Python pip cache
ml/.pip-cache/